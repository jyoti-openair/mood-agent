# ============================================================
# LLM — Gemini (used both by Cognee internally and by your
# own direct calls in cognee_service.py)
# ============================================================
LLM_PROVIDER=gemini
LLM_MODEL=gemini/gemini-3.6-flash
LLM_API_KEY=your_gemini_api_key_here
LLM_ENDPOINT=

GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================
# Embeddings — Gemini (used by Cognee for vector search)
# ============================================================
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini/gemini-embedding-001
EMBEDDING_API_KEY=your_gemini_api_key_here
EMBEDDING_DIMENSIONS=768
EMBEDDING_ENDPOINT=

# ============================================================
# Graph store
# ============================================================
GRAPH_DATABASE_PROVIDER=kuzu

# ============================================================
# Storage directories
# ============================================================
SYSTEM_ROOT_DIRECTORY=/app/.cognee
DATA_ROOT_DIRECTORY=/app/.cognee

# ============================================================
# App
# ============================================================
PDF_DIR=./pdfs
COGNEE_DATASET_NAME=your_db_name_here
ENABLE_BACKEND_ACCESS_CONTROL=false

COGNEE_DATA_ROOT=/app/.cognee
COGNEE_LOG_DIR=./.cognee/logs

# Extend LiteLLM request timeout to 30 minutes
LITELLM_REQUEST_TIMEOUT=1800

LLM_RATE_LIMIT_ENABLED=true
LLM_RATE_LIMIT_TOKENS=7500
LLM_RATE_LIMIT_INTERVAL=60
LLM_RATE_LIMIT_REQUESTS=30


