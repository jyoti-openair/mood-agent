# --- Gemini (free tier) ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Cognee ---
# Cognee needs an LLM to build the knowledge graph during cognify().
# You can reuse your Gemini key for this so you don't need OpenAI at all.
LLM_PROVIDER=gemini
LLM_MODEL=gemini/gemini-2.5-flash
LLM_API_KEY=your_gemini_api_key_here
LLM_MAX_TOKENS=8192

# Embeddings - Cognee also needs an embedding model.
# Gemini's embedding model works fine and keeps everything on one free key.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini/gemini-embedding-001
EMBEDDING_API_KEY=your_gemini_api_key_here
EMBEDDING_DIMENSIONS=3072

# Graph/vector storage: Cognee defaults to local Kuzu (graph) + LanceDB
# (vector) + SQLite (relational) - no extra setup needed for this project.

# --- App ---
# Where your PDFs live (folder can have subfolders)
PDF_DIR=./pdfs
COGNEE_DATASET_NAME=teachings
